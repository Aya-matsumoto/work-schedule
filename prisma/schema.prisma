generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 業務（案件）
model Project {
  id               Int              @id @default(autoincrement())
  name             String
  client           String?
  fiscalYear       String?
  deadline         DateTime?
  note             String?
  displayOrder     Int              @default(0)
  bridges               Bridge[]
  processes             ProcessRecord[]
  staffAssignments      ProjectStaff[]
  processStaffAssignments ProjectProcessStaff[]
  createdAt             DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// 橋梁
model Bridge {
  id               Int               @id @default(autoincrement())
  projectId        Int
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  serialNo         String?
  spans            Int?
  spanCount        Int               @default(1)
  spanCoefficient  Float             @default(4)
  inspectionDate   DateTime?
  inspectionNote   String?
  processes        ProcessRecord[]
  assignments      BridgeAssignment[]
  processConfigs   BridgeProcessConfig[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([projectId])
}

// 担当者
model Staff {
  id                 Int               @id @default(autoincrement())
  name               String
  type               String            @default("EMPLOYEE")
  color              String            @default("#378ADD")
  processes                 ProcessRecord[]
  shifts                    StaffShift[]
  assignments               BridgeAssignment[]
  projectAssignments        ProjectStaff[]
  processRecords            ProcessRecordStaff[]
  projectProcessAssignments ProjectProcessStaff[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

// 業務別担当者
model ProjectStaff {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  priority  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([projectId, staffId])
}

// 業務×工程別担当者（工程割り振り用）
model ProjectProcessStaff {
  id              Int      @id @default(autoincrement())
  projectId       Int
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffId         Int
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  processTypeName String
  createdAt       DateTime @default(now())

  @@unique([projectId, staffId, processTypeName])
}

// 工程種別マスタ
model ProcessType {
  id                 Int                   @id @default(autoincrement())
  name               String
  order              Int
  color              String                @default("#378ADD")
  allowMultipleStaff Boolean               @default(false)
  allowAddIteration  Boolean               @default(false)
  processes          ProcessRecord[]
  bridgeConfigs      BridgeProcessConfig[]
  bridgeAssignments  BridgeAssignment[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

// 工程レコード
model ProcessRecord {
  id            Int                  @id @default(autoincrement())
  bridgeId      Int?
  bridge        Bridge?              @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  projectId     Int?
  project       Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  processTypeId Int
  processType   ProcessType          @relation(fields: [processTypeId], references: [id])
  staffId       Int?
  staff         Staff?               @relation(fields: [staffId], references: [id])
  staffMembers  ProcessRecordStaff[]
  status        String               @default("NOT_STARTED")
  startDate     DateTime?
  endDate       DateTime?
  completedDate DateTime?
  note          String?
  iteration     Int                  @default(1)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([bridgeId])
  @@index([projectId])
  @@index([processTypeId])
  @@index([staffId])
  @@index([startDate, endDate])
}

// 工程レコード担当者（複数担当者対応）
model ProcessRecordStaff {
  id              Int           @id @default(autoincrement())
  processRecordId Int
  processRecord   ProcessRecord @relation(fields: [processRecordId], references: [id], onDelete: Cascade)
  staffId         Int
  staff           Staff         @relation(fields: [staffId], references: [id])

  @@unique([processRecordId, staffId])
  @@index([staffId])
}

// 担当者シフト・勤務時間
model StaffShift {
  id                 Int                  @id @default(autoincrement())
  staffId            Int
  staff              Staff                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  defaultHoursPerDay Float                @default(8)
  weekPattern        Json
  validFrom          DateTime
  validTo            DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  overrides          StaffShiftOverride[]

  @@index([staffId])
}

// 勤務時間の個別変更
model StaffShiftOverride {
  id          Int        @id @default(autoincrement())
  shiftId     Int
  shift       StaffShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date        DateTime
  hoursPerDay Float
  note        String?
  createdAt   DateTime   @default(now())

  @@index([shiftId])
}

// システム設定
model SystemSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// 橋梁担当割り当て
model BridgeAssignment {
  id                 Int          @id @default(autoincrement())
  bridgeId           Int
  bridge             Bridge       @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  staffId            Int
  staff              Staff        @relation(fields: [staffId], references: [id])
  processTypeId      Int?
  processType        ProcessType? @relation(fields: [processTypeId], references: [id])
  fiscalYear         Int
  priority           Int          @default(1)
  inspectionDoneDate DateTime?
  startDate          DateTime?
  endDate            DateTime?
  isManual           Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([bridgeId])
  @@index([staffId])
  @@index([processTypeId])
  @@index([startDate, endDate])
}

// 会社公休日
model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime
  name      String   @default("")
  createdAt DateTime @default(now())
}

// 橋梁×工程種別の必要時間設定
model BridgeProcessConfig {
  id              Int          @id @default(autoincrement())
  bridgeId        Int
  bridge          Bridge       @relation(fields: [bridgeId], references: [id], onDelete: Cascade)
  processTypeId   Int
  processType     ProcessType  @relation(fields: [processTypeId], references: [id])
  spanCount       Int?
  spanCoefficient Float?
  requiredHours   Float?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([bridgeId, processTypeId])
  @@index([processTypeId])
}
